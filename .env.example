# For a physical phone, replace 192.168.1.10 with the computer's LAN address.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# API settings (copy to apps/api/.env when overriding defaults)
DATABASE_URL=file:./dev.db
PORT=4000
HOST=0.0.0.0
JWT_SECRET=change-this-local-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-this-refresh-secret-at-least-32-characters
PROVIDER_MODE=mock
STORAGE_MODE=local
PAYMENT_MODE=mock
MOCK_GENERATION_SECONDS=10
MAX_UPLOAD_MB=50
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=seedance-1-5-pro-251215
SEEDANCE_FRAMES_MODEL=seedance-1-0-pro-250528
