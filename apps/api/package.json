{
  "name": "@klyvo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--require=./scripts/node-os-shim.cjs tsx watch src/server.ts",
    "start": "prisma migrate deploy && cross-env NODE_OPTIONS=--require=./scripts/node-os-shim.cjs tsx src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src test prisma",
    "test": "cross-env NODE_OPTIONS=--require=./scripts/node-os-shim.cjs tsx scripts/prepare-test-db.ts && cross-env DATABASE_URL=file:./test.db prisma db push --force-reset --skip-generate && cross-env NODE_OPTIONS=--require=./scripts/node-os-shim.cjs DATABASE_URL=file:./test.db PROVIDER_MODE=mock STORAGE_MODE=local MOCK_GENERATION_SECONDS=0 vitest run --sequence.concurrent=false",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:seed": "cross-env NODE_OPTIONS=--require=./scripts/node-os-shim.cjs tsx prisma/seed.ts",
    "db:remove-demo": "cross-env NODE_OPTIONS=--require=./scripts/node-os-shim.cjs tsx scripts/remove-demo-videos.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@klyvo/shared": "*",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "cross-env": "^10.1.0",
    "prisma": "^6.19.2",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
