generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  displayName        String
  avatarUrl          String?
  language           String              @default("ru")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  wallet             CreditWallet?
  refreshTokens      RefreshToken[]
  creditTransactions CreditTransaction[]
  generations        Generation[]
  assets             GenerationAsset[]
  videos             Video[]
  publications       VideoPublication[]
  purchases          Purchase[]
  reports            Report[]
  likes              VideoLike[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreditWallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  balance         Int      @default(0)
  reservedBalance Int      @default(0)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id            String      @id @default(cuid())
  userId        String
  type          String
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  generationId  String?
  purchaseId    String?
  description   String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation    Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  purchase      Purchase?   @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@unique([generationId, type])
  @@unique([purchaseId, type])
  @@index([userId, createdAt])
}

model Generation {
  id               String              @id @default(cuid())
  batchId          String              @default(cuid())
  batchIndex       Int                 @default(1)
  batchSize        Int                 @default(1)
  userId           String
  mode             String
  status           String              @default("QUEUED")
  originalPrompt   String
  enhancedPrompt   String?
  detectedLanguage String
  aspectRatio      String
  timingMode       String              @default("DURATION")
  duration         Int
  frames           Int?
  resolution       String              @default("720p")
  generateAudio    Boolean             @default(true)
  firstFrameAssetId String?
  lastFrameAssetId String?
  style            String
  cameraMotion     String
  creditCost       Int
  reservedCredits  Int
  provider         String
  /** Идентификатор модели из общего реестра (videoModels), выбранный пользователем. */
  modelId          String?
  /** Конкретное имя модели у провайдера, с которым ушёл запрос. */
  model            String              @default("seedance-1-5-pro-251215")
  providerTaskId   String?
  forceFailure     Boolean             @default(false)
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime            @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets           GenerationAsset[]
  video            Video?
  transactions     CreditTransaction[]

  @@index([userId, createdAt])
  @@index([batchId])
  @@index([status])
}

model GenerationAsset {
  id           String      @id @default(cuid())
  generationId String?
  userId       String
  type         String
  storageKey   String
  mimeType     String
  fileName     String
  fileSize     Int
  createdAt    DateTime    @default(now())
  generation   Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Video {
  id           String            @id @default(cuid())
  generationId String            @unique
  userId       String
  videoUrl     String
  thumbnailUrl String
  videoStorageKey String?
  thumbnailStorageKey String?
  /** Облегчённая копия для ленты: 480p без звука. Генерируется фоном после готовности. */
  previewStorageKey String?
  /** Уменьшенное превью для плиток ленты. Готовится заранее, чтобы можно было отдавать прямой ссылкой. */
  thumbnailPreviewStorageKey String?
  duration     Float
  width        Int
  height       Int
  fileSize     Int
  visibility   String            @default("PRIVATE")
  createdAt    DateTime          @default(now())
  deletedAt    DateTime?
  generation   Generation        @relation(fields: [generationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  publication  VideoPublication?
  reports      Report[]
  likes        VideoLike[]

  @@index([userId, createdAt])
}

model VideoPublication {
  id             String   @id @default(cuid())
  videoId        String   @unique
  userId         String
  showAuthor     Boolean  @default(true)
  showPrompt     Boolean  @default(false)
  allowRemix     Boolean  @default(true)
  allowDownload  Boolean  @default(false)
  allowTemplate  Boolean  @default(false)
  moderationStatus String @default("APPROVED")
  likesCount     Int      @default(0)
  viewsCount     Int      @default(0)
  publishedAt    DateTime @default(now())
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
}

model Purchase {
  id            String              @id @default(cuid())
  userId        String
  platform      String
  productId     String
  purchaseToken String              @unique
  status        String
  credits       Int
  priceAmount   Int
  currency      String
  createdAt     DateTime            @default(now())
  verifiedAt    DateTime?
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  CreditTransaction[]

  @@index([userId, createdAt])
}

model Report {
  id         String   @id @default(cuid())
  videoId    String
  userId     String
  reason     String
  status     String   @default("RECEIVED")
  createdAt  DateTime @default(now())
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
}

model VideoLike {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
}

model AppConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
